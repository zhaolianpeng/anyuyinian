/* pages/service/detail.wxss */
page {
  background-color: #f5f5f5;
  overflow-x: hidden;
  width: 100vw;
  max-width: 100vw;
}

.service-detail-container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 120rpx;
  width: 100%;
  max-width: 100%;
  overflow-x: hidden;
  box-sizing: border-box;
  position: relative;
}

/* 服务头部 */
.service-header {
  background: white;
  padding: 30rpx;
  display: flex;
  align-items: center;
}

.service-image {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  margin-right: 30rpx;
  flex-shrink: 0;
}

.service-info {
  flex: 1;
}

.service-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 15rpx;
  word-wrap: break-word;
  overflow-wrap: break-word;
  max-width: 100%;
}

.service-description {
  font-size: 28rpx;
  color: #666;
  line-height: 1.5;
  display: block;
  margin-bottom: 15rpx;
  word-wrap: break-word;
  overflow-wrap: break-word;
  max-width: 100%;
}

.service-category {
  margin-top: 10rpx;
}

.category-tag {
  background: #e6f7ff;
  color: #1890ff;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
}

/* 视频播放区域 */
.video-section {
  background: white;
  margin-top: 20rpx;
  padding: 30rpx;
}

.product-video {
  width: 100%;
  height: 400rpx;
  border-radius: 12rpx;
  margin-top: 20rpx;
}

/* 价格区域 */
.price-section {
  background: white;
  margin-top: 20rpx;
  padding: 30rpx;
}

.price-info {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.current-price {
  font-size: 48rpx;
  color: #ff6b35;
  font-weight: bold;
}

.original-price {
  font-size: 28rpx;
  color: #999;
  text-decoration: line-through;
}

.discount {
  background: #ff6b35;
  color: white;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
}

/* 服务详情 */
.service-details {
  background: white;
  margin-top: 20rpx;
  padding: 30rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.section-subtitle {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 16rpx;
}

.label-tip {
  font-size: 22rpx;
  color: #999;
  margin-left: 8rpx;
  font-weight: normal;
}

.detail-content {
  background: #f8f9fa;
  border-radius: 8rpx;
  padding: 20rpx;
}

.detail-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
  word-wrap: break-word;
  overflow-wrap: break-word;
  max-width: 100%;
}

/* 患者信息选择 */
.patient-section {
  background: white;
  margin-top: 20rpx;
  padding: 30rpx;
}

.patient-selector {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx;
  background: #f8f9fa;
  border-radius: 8rpx;
  border: 1rpx solid #eee;
  margin-bottom: 20rpx;
}

.add-button {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx;
  background: #f0f8ff;
  border: 1rpx dashed #1890ff;
  border-radius: 8rpx;
  cursor: pointer;
  transition: all 0.3s;
}

.add-button:active {
  background: #e6f7ff;
}

.add-text {
  font-size: 28rpx;
  color: #1890ff;
  font-weight: 500;
}

.selector-content {
  flex: 1;
}

.selected-info {
  display: flex;
  flex-direction: column;
}

.info-name {
  font-size: 30rpx;
  color: #333;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.info-detail {
  font-size: 26rpx;
  color: #666;
}

.placeholder {
  display: flex;
  align-items: center;
}

.placeholder-text {
  font-size: 28rpx;
  color: #999;
}

.selector-arrow {
  font-size: 24rpx;
  color: #999;
  margin-left: 20rpx;
}

/* 地址选择 */
.address-section {
  background: white;
  margin-top: 20rpx;
  padding: 30rpx;
}

.address-selector {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx;
  background: #f8f9fa;
  border-radius: 8rpx;
  border: 1rpx solid #eee;
  margin-bottom: 20rpx;
}

/* 预约表单 */
.booking-form {
  background: white;
  margin-top: 20rpx;
  padding: 30rpx;
}

.form-content {
  background: #f8f9fa;
  border-radius: 8rpx;
  padding: 20rpx;
}

.form-item {
  margin-bottom: 30rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-label {
  display: flex;
  align-items: center;
  margin-bottom: 15rpx;
}

.label-text {
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
}

.required {
  color: #ff4d4f;
  margin-left: 5rpx;
}

.form-input {
  width: 100%;
  height: 80rpx;
  padding: 0 20rpx;
  background: white;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
  max-width: 100%;
}

.form-picker {
  width: 100%;
  height: 80rpx;
  background: white;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  padding: 0 20rpx;
}

.picker-text {
  font-size: 28rpx;
  color: #333;
}

.radio-group {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
}

.radio-item {
  display: flex;
  align-items: center;
  padding: 15rpx 20rpx;
  background: white;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
}

.radio-text {
  font-size: 28rpx;
  color: #333;
  margin-left: 15rpx;
}

.form-textarea {
  width: 100%;
  min-height: 120rpx;
  padding: 20rpx;
  background: white;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  font-size: 28rpx;
  color: #333;
  line-height: 1.5;
  box-sizing: border-box;
  max-width: 100%;
  word-wrap: break-word;
  overflow-wrap: break-word;
}

/* 信息显示样式 */
.info-display {
  width: 100%;
  height: 80rpx;
  background: #f8f9fa;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 20rpx;
}

.info-text {
  font-size: 28rpx;
  color: #666;
  text-align: center;
}

/* 字符计数样式 */
.char-count {
  font-size: 24rpx;
  color: #999;
  text-align: right;
  margin-top: 10rpx;
}

/* 时间选择 */
.time-section {
  background: white;
  margin-top: 20rpx;
  padding: 30rpx;
}

.time-selector {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx;
  background: #f8f9fa;
  border-radius: 8rpx;
  border: 1rpx solid #eee;
}

/* 备注信息 */
.remark-section {
  background: white;
  margin-top: 20rpx;
  padding: 30rpx;
}

.remark-textarea {
  width: 100%;
  min-height: 120rpx;
  padding: 20rpx;
  background: #f8f9fa;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  font-size: 28rpx;
  color: #333;
  line-height: 1.5;
}

/* 底部操作栏 */
.bottom-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: white;
  padding: 20rpx 30rpx;
  border-top: 1rpx solid #eee;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.1);
  width: 100%;
  max-width: 100vw;
  box-sizing: border-box;
}

.price-summary {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  margin-bottom: 20rpx;
}

.summary-label {
  font-size: 28rpx;
  color: #666;
}

.summary-price {
  font-size: 36rpx;
  color: #ff6b35;
  font-weight: bold;
  margin-left: 10rpx;
}

.action-buttons {
  display: flex;
  gap: 20rpx;
}

.btn-secondary {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  background: white;
  color: #666;
  border: 1rpx solid #ddd;
  border-radius: 40rpx;
  font-size: 28rpx;
}

.btn-primary {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  background: #ff6b35;
  color: white;
  border: none;
  border-radius: 40rpx;
  font-size: 28rpx;
}

/* 弹窗样式 */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
  width: 100vw;
  max-width: 100vw;
  overflow: hidden;
}

.modal-content {
  width: 80%;
  max-width: 80vw;
  max-height: 70%;
  background: white;
  border-radius: 12rpx;
  overflow: hidden;
  box-sizing: border-box;
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx;
  border-bottom: 1rpx solid #eee;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.modal-close {
  font-size: 40rpx;
  color: #999;
  padding: 10rpx;
}

.modal-body {
  max-height: 400rpx;
  overflow-y: auto;
}

.modal-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx;
  border-bottom: 1rpx solid #eee;
}

.modal-item:last-child {
  border-bottom: none;
}

.item-info {
  flex: 1;
}

.item-name {
  font-size: 30rpx;
  color: #333;
  font-weight: bold;
  display: block;
  margin-bottom: 8rpx;
}

.item-detail {
  font-size: 26rpx;
  color: #666;
  display: block;
}

.item-check {
  font-size: 32rpx;
  color: #ff6b35;
  font-weight: bold;
}

.empty-state {
  padding: 60rpx 30rpx;
  text-align: center;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

/* 加载状态 */
.loading-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
}

.loading-content {
  background: white;
  padding: 40rpx;
  border-radius: 12rpx;
  text-align: center;
}

.loading-text {
  font-size: 28rpx;
  color: #333;
}