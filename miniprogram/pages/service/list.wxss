.service-list-container {
  min-height: 100vh;
  background-color: #f5f5f5;
}


.search-bar {
  background: white;
  padding: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.search-input {
  background: #f8f8f8;
  border-radius: 20rpx;
  padding: 20rpx 30rpx;
  font-size: 28rpx;
}

.category-tabs {
  background: white;
  border-bottom: 1rpx solid #f0f0f0;
}

.category-scroll {
  white-space: nowrap;
}

.category-list {
  display: flex;
  padding: 20rpx;
}

.category-item {
  padding: 15rpx 30rpx;
  margin-right: 20rpx;
  border-radius: 25rpx;
  font-size: 28rpx;
  color: #666;
  background: #f8f8f8;
  white-space: nowrap;
}

.category-item.active {
  background: #007aff;
  color: white;
}

.service-list {
  padding: 20rpx;
}

.service-item {
  background: white;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.service-item:active {
  transform: scale(0.98);
}

.service-image {
  width: 100%;
  height: 300rpx;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

.service-image image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
}

.service-content {
  padding: 30rpx;
}

.service-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 15rpx;
  line-height: 1.4;
}

.service-desc {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 15rpx;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.service-category {
  font-size: 24rpx;
  color: #007aff;
  background: rgba(0, 122, 255, 0.1);
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  display: inline-block;
  margin-bottom: 20rpx;
}

.service-price {
  display: flex;
  align-items: center;
}

.current-price {
  font-size: 36rpx;
  font-weight: bold;
  color: #ff4757;
  margin-right: 15rpx;
}

.original-price {
  font-size: 26rpx;
  color: #999;
  text-decoration: line-through;
}

.loading-more,
.no-more {
  text-align: center;
  padding: 40rpx;
  color: #999;
  font-size: 26rpx;
}

.empty-state {
  text-align: center;
  padding: 100rpx 40rpx;
  color: #999;
}

.empty-state image {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 30rpx;
}

.empty-state text {
  font-size: 28rpx;
  display: block;
} 