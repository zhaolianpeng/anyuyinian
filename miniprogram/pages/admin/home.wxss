.admin-home-container {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 0;
}

.admin-header {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 40rpx 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  color: #ffffff;
}

.admin-info {
  display: flex;
  align-items: center;
}

.admin-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 40rpx;
  margin-right: 20rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.3);
}

.admin-details {
  display: flex;
  flex-direction: column;
}

.admin-name {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.admin-level {
  font-size: 24rpx;
  opacity: 0.8;
}

.logout-btn {
  padding: 16rpx 24rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 20rpx;
  font-size: 26rpx;
}

.stats-section {
  background: #ffffff;
  margin: 20rpx;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.stats-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 30rpx;
}

.stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 30rpx;
}

.stat-item {
  text-align: center;
  padding: 30rpx 20rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
}

.stat-number {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #667eea;
  margin-bottom: 10rpx;
}

.paid-amount {
  color: #52c41a !important;
}

.unpaid-amount {
  color: #faad14 !important;
}

.refund-amount {
  color: #ff4d4f !important;
}

.timeout-amount {
  color: #fa8c16 !important;
}

.stats-label {
  font-size: 24rpx;
  color: #666;
  display: block;
}

.menu-section {
  background: #ffffff;
  margin: 20rpx;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.menu-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 30rpx;
}

.menu-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.menu-item {
  background: #f8f9fa;
  border-radius: 12rpx;
  padding: 30rpx 20rpx;
  text-align: center;
  transition: all 0.3s ease;
}

.menu-item:active {
  transform: scale(0.98);
  background: #e9ecef;
}

.menu-icon {
  font-size: 48rpx;
  margin-bottom: 16rpx;
  display: block;
}

.menu-text {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 8rpx;
}

.menu-desc {
  display: block;
  font-size: 22rpx;
  color: #666666;
}

.loading {
  text-align: center;
  padding: 60rpx;
  color: #999999;
  font-size: 28rpx;
}

/* 咨询相关样式 */
.waiting-consultations {
  color: #ff4d4f !important;
}

.total-consultations {
  color: #1890ff !important;
}

.consultation-badge {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  background: #ff4d4f;
  color: white;
  border-radius: 50%;
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  font-weight: bold;
}

.menu-item {
  position: relative;
} 