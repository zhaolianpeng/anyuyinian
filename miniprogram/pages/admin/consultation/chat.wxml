<view class="chat-container">
  <!-- 顶部导航栏 -->
  <view class="header">
    <view class="back-btn" bindtap="onBack">
      <text class="back-icon">←</text>
    </view>
    <view class="title">回复咨询</view>
    <view class="user-info" wx:if="{{consultation}}">
      <text class="user-name">{{consultation.userName}}</text>
      <text class="user-phone">{{consultation.userPhone}}</text>
    </view>
  </view>

  <!-- 聊天记录区域 -->
  <scroll-view class="chat-area" scroll-y="true" scroll-into-view="{{scrollToMessage}}" scroll-with-animation="true">
    <view class="chat-messages" wx:if="{{messages.length > 0}}">
      <view 
        wx:for="{{messages}}" 
        wx:key="id" 
        class="message-item {{item.senderType === 'user' ? 'user-message' : 'admin-message'}}"
        id="msg-{{item.id}}"
      >
        <view class="message-avatar">
          <image 
                            src="{{item.senderType === 'user' ? '/images/default-avatar.png' : '/images/default-avatar.png'}}" 
            class="avatar-img"
          />
        </view>
        <view class="message-content">
          <view class="message-text">{{item.content}}</view>
          <view class="message-time">{{item.createTime}}</view>
        </view>
      </view>
    </view>
    
    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{messages.length === 0}}">
      <image src="/images/empty-state.png" class="empty-image" />
      <text class="empty-text">暂无消息</text>
      <text class="empty-subtext">开始回复用户的咨询吧</text>
    </view>
  </scroll-view>

  <!-- 输入区域 -->
  <view class="input-area">
    <view class="input-container">
      <input 
        class="message-input" 
        placeholder="请输入回复内容..." 
        value="{{inputMessage}}"
        bindinput="onInputChange"
        bindconfirm="sendMessage"
        confirm-type="send"
        maxlength="500"
      />
      <view class="send-btn {{inputMessage.trim() ? 'active' : ''}}" bindtap="sendMessage">
        <text class="send-text">发送</text>
      </view>
    </view>
    
    <!-- 快捷回复 -->
    <view class="quick-replies" wx:if="{{messages.length === 0}}">
      <text class="quick-title">快捷回复：</text>
      <view class="reply-tags">
        <view 
          wx:for="{{quickReplies}}" 
          wx:key="index"
          class="reply-tag"
          bindtap="onQuickReplyTap"
          data-reply="{{item}}"
        >
          {{item}}
        </view>
      </view>
    </view>
  </view>
</view>
