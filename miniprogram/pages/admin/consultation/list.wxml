<view class="consultation-list-container">
  <!-- 顶部统计 -->
  <view class="stats-section">
    <view class="stat-item">
      <text class="stat-number">{{stats.totalCount}}</text>
      <text class="stat-label">总咨询</text>
    </view>
    <view class="stat-item waiting">
      <text class="stat-number">{{stats.waitingCount}}</text>
      <text class="stat-label">等待回复</text>
    </view>
    <view class="stat-item chatting">
      <text class="stat-number">{{stats.chattingCount}}</text>
      <text class="stat-label">咨询中</text>
    </view>
    <view class="stat-item">
      <text class="stat-number">{{stats.todayCount}}</text>
      <text class="stat-label">今日新增</text>
    </view>
  </view>

  <!-- 筛选标签 -->
  <view class="filter-tabs">
    <view 
      wx:for="{{filterTabs}}" 
      wx:key="value"
      class="filter-tab {{currentFilter === item.value ? 'active' : ''}}"
      bindtap="onFilterTabTap"
      data-value="{{item.value}}"
    >
      {{item.label}}
    </view>
  </view>

  <!-- 咨询列表 -->
  <scroll-view class="consultation-list" scroll-y="true" bindscrolltolower="onLoadMore">
    <view 
      wx:for="{{consultations}}" 
      wx:key="id"
      class="consultation-item"
      bindtap="onConsultationTap"
      data-id="{{item.id}}"
    >
      <view class="consultation-header">
        <view class="user-info">
          <image src="/images/default-avatar.png" class="user-avatar" />
          <view class="user-details">
            <text class="user-name">{{item.userName}}</text>
            <text class="user-phone">{{item.userPhone}}</text>
          </view>
        </view>
        <view class="status-badge {{item.status}}">
          {{item.status === 'waiting' ? '等待回复' : item.status === 'chatting' ? '咨询中' : '已结束'}}
        </view>
      </view>
      
      <view class="consultation-content">
        <text class="last-message">{{item.lastMessage || '暂无消息'}}</text>
        <text class="time">{{item.createTime}}</text>
      </view>
      
      <view class="consultation-footer">
        <view class="message-count">
          <text class="count-text">{{item.messageCount || 0}} 条消息</text>
        </view>
        <view class="action-buttons">
          <view class="action-btn reply" wx:if="{{item.status !== 'closed'}}" catchtap="onReplyTap" data-id="{{item.id}}">
            回复
          </view>
          <view class="action-btn close" wx:if="{{item.status !== 'closed'}}" catchtap="onCloseTap" data-id="{{item.id}}">
            结束
          </view>
        </view>
      </view>
    </view>
    
    <!-- 加载更多 -->
    <view class="load-more" wx:if="{{hasMore}}">
      <text class="load-text">加载中...</text>
    </view>
    
    <!-- 没有更多 -->
    <view class="no-more" wx:if="{{!hasMore && consultations.length > 0}}">
      <text class="no-more-text">没有更多了</text>
    </view>
    
    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{consultations.length === 0 && !loading}}">
              <image src="/images/empty-state.png" class="empty-image" />
      <text class="empty-text">暂无咨询</text>
      <text class="empty-subtext">用户发起咨询后会显示在这里</text>
    </view>
  </scroll-view>

  <!-- 悬浮按钮 -->
  <view class="fab-button" bindtap="onRefresh">
    <text class="fab-icon">↻</text>
  </view>
</view>
