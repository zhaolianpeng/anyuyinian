<!--pages/admin/services.wxml-->
<view class="container">
  <!-- 页面标题 -->
  <view class="header">
    <text class="title">服务管理</text>
  </view>

  <!-- 分类筛选 -->
  <view class="filter-section">
    <picker mode="selector" range="{{categories}}" value="{{selectedCategoryIndex}}" bindchange="onCategoryChange">
      <view class="picker">
        <text class="picker-label">分类筛选：</text>
        <text class="picker-value">{{selectedCategory || '全部'}}</text>
        <text class="picker-arrow">></text>
      </view>
    </picker>
  </view>

  <!-- 服务列表 -->
  <view class="service-list">
    <view class="service-item" wx:for="{{services}}" wx:key="id">
      <view class="service-header">
        <view class="service-info">
          <text class="service-name">{{item.name}}</text>
          <text class="service-category">{{item.category}}</text>
        </view>
        <view class="service-status">
          <text class="status-text {{item.status === 1 ? 'status-online' : 'status-offline'}}">
            {{item.statusText}}
          </text>
        </view>
      </view>

      <view class="service-content">
        <view class="service-description">{{item.description}}</view>
        
        <view class="price-section">
          <view class="price-item">
            <text class="price-label">现价：</text>
            <text class="price-value">¥{{item.displayPrice}}</text>
          </view>
          <view class="price-item">
            <text class="price-label">原价：</text>
            <text class="price-value original-price">¥{{item.displayOriginalPrice}}</text>
          </view>
        </view>

        <view class="service-meta">
          <text class="meta-item">排序：{{item.sort}}</text>
          <text class="meta-item">更新时间：{{item.displayUpdatedAt}}</text>
        </view>
      </view>

      <view class="service-actions">
        <button class="action-btn edit-btn" bindtap="showPriceModal" data-service="{{item}}">
          修改价格
        </button>
      </view>
    </view>
  </view>

  <!-- 加载更多 -->
  <view class="load-more" wx:if="{{hasMore}}">
    <text wx:if="{{loading}}">加载中...</text>
    <text wx:else>上拉加载更多</text>
  </view>

  <!-- 无数据提示 -->
  <view class="empty-state" wx:if="{{services.length === 0 && !loading}}">
    <text class="empty-text">暂无服务数据</text>
  </view>
</view>

<!-- 价格修改弹窗 -->
<view class="modal-overlay" wx:if="{{showPriceModal}}" bindtap="hidePriceModal">
  <view class="modal-content" catchtap="preventClose">
    <view class="modal-header">
      <text class="modal-title">修改服务价格</text>
      <text class="modal-close" bindtap="hidePriceModal">×</text>
    </view>

    <view class="modal-body">
      <view class="service-info">
        <text class="service-name">{{currentService.name}}</text>
        <text class="service-category">{{currentService.category}}</text>
      </view>

      <view class="form-group">
        <text class="form-label">现价 (元)</text>
        <input class="form-input" type="digit" value="{{newPrice}}" bindinput="onPriceInput" placeholder="请输入新的价格" />
      </view>

      <view class="form-group">
        <text class="form-label">原价 (元)</text>
        <input class="form-input" type="digit" value="{{newOriginalPrice}}" bindinput="onOriginalPriceInput" placeholder="请输入新的原价" />
      </view>

      <view class="form-group">
        <text class="form-label">修改原因</text>
        <textarea class="form-textarea" value="{{reason}}" bindinput="onReasonInput" placeholder="请输入修改原因" maxlength="200"></textarea>
      </view>
    </view>

    <view class="modal-footer">
      <button class="btn btn-cancel" bindtap="hidePriceModal">取消</button>
      <button class="btn btn-confirm" bindtap="submitPriceUpdate" loading="{{submitting}}">
        {{submitting ? '提交中...' : '确认修改'}}
      </button>
    </view>
  </view>
</view> 