/* 管理员管理页面样式 */
.admins-container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

/* 页面标题 */
.page-header {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 40rpx 30rpx;
  border-radius: 20rpx;
  margin-bottom: 30rpx;
  color: white;
}

.page-title {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.page-desc {
  display: block;
  font-size: 28rpx;
  opacity: 0.8;
}

/* 管理员列表 */
.admins-list {
  background: white;
  border-radius: 20rpx;
  overflow: hidden;
}

.admin-item {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.admin-item:last-child {
  border-bottom: none;
}

.admin-info {
  display: flex;
  align-items: center;
  flex: 1;
}

.admin-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}

.admin-details {
  flex: 1;
  padding-right: 20rpx;
  min-width: 0;
}

.admin-name {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.admin-level {
  display: block;
  font-size: 26rpx;
  color: #667eea;
  margin-bottom: 6rpx;
}

.admin-phone {
  display: block;
  font-size: 24rpx;
  color: #666;
  margin-bottom: 4rpx;
}

.admin-time {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-bottom: 4rpx;
  line-height: 1.4;
  word-break: break-all;
}

.admin-amount {
  display: block;
  font-size: 22rpx;
  color: #ff6b35;
  font-weight: bold;
  margin-bottom: 4rpx;
  line-height: 1.4;
}

.admin-actions {
  display: flex;
  gap: 20rpx;
  flex-shrink: 0;
  min-width: 120rpx;
}

.action-btn {
  padding: 16rpx 24rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
  border: none;
  min-width: 120rpx;
}

.set-btn {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
}

.remove-btn {
  background: #ff4757;
  color: white;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 100rpx 40rpx;
  background: white;
  border-radius: 20rpx;
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  display: block;
  font-size: 32rpx;
  color: #333;
  margin-bottom: 10rpx;
}

.empty-desc {
  display: block;
  font-size: 28rpx;
  color: #666;
}

/* 加载状态 */
.loading {
  text-align: center;
  padding: 60rpx;
  color: #666;
  font-size: 28rpx;
}

/* 加载更多 */
.load-more {
  text-align: center;
  padding: 30rpx;
  color: #999;
  font-size: 26rpx;
} 