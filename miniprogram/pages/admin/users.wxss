.admin-users-container {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 0;
}

.page-header {
  background: #ffffff;
  padding: 30rpx;
  border-bottom: 1rpx solid #e0e0e0;
}

.page-title {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 10rpx;
}

.page-subtitle {
  display: block;
  font-size: 26rpx;
  color: #666666;
}

.users-list {
  padding: 20rpx;
}

.user-item {
  background: #ffffff;
  border-radius: 12rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.user-info {
  display: flex;
  align-items: center;
  flex: 1;
}

.user-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 40rpx;
  margin-right: 20rpx;
}

.user-details {
  flex: 1;
}

.user-name {
  display: block;
  font-size: 30rpx;
  font-weight: 500;
  color: #333333;
  margin-bottom: 8rpx;
}

.user-phone {
  display: block;
  font-size: 26rpx;
  color: #666666;
  margin-bottom: 8rpx;
}

.user-level {
  display: block;
  font-size: 24rpx;
  color: #999999;
}

.user-actions {
  margin-left: 20rpx;
}

.action-btn {
  min-width: 120rpx;
  height: 60rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.set-admin-btn {
  background: #667eea;
  color: #ffffff;
}

.set-admin-btn:active {
  background: #5a6fd8;
}

.remove-admin-btn {
  background: #ff6b35;
  color: #ffffff;
}

.remove-admin-btn:active {
  background: #e55a2b;
}

.empty-state {
  text-align: center;
  padding: 100rpx 40rpx;
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 30rpx;
  opacity: 0.5;
}

.empty-text {
  display: block;
  font-size: 28rpx;
  color: #999999;
}

.loading-state {
  text-align: center;
  padding: 60rpx;
  color: #999999;
  font-size: 28rpx;
}

.load-more {
  text-align: center;
  padding: 40rpx;
  color: #999999;
  font-size: 26rpx;
}

.no-more {
  text-align: center;
  padding: 40rpx;
  color: #999999;
  font-size: 26rpx;
} 