.admin-orders-container {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 0;
}

.page-header {
  background: #ffffff;
  padding: 30rpx;
  border-bottom: 1rpx solid #e0e0e0;
}

.page-title {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 10rpx;
}

.page-subtitle {
  display: block;
  font-size: 26rpx;
  color: #666666;
}

.orders-list {
  padding: 20rpx;
}

.order-item {
  background: #ffffff;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  overflow: hidden;
}

.order-content-wrapper {
  padding: 30rpx;
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.order-no {
  font-size: 28rpx;
  color: #333333;
  font-weight: 500;
}

.order-status {
  font-size: 26rpx;
  font-weight: bold;
}

.order-content {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.order-info {
  flex: 1;
}

.service-name {
  display: block;
  font-size: 30rpx;
  color: #333333;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.user-name {
  display: block;
  font-size: 26rpx;
  color: #666666;
}

.order-amount {
  text-align: right;
}

.amount {
  font-size: 32rpx;
  font-weight: bold;
  color: #ff6b35;
}

.order-footer {
  border-top: 1rpx solid #f0f0f0;
  padding-top: 20rpx;
}

.order-time {
  font-size: 24rpx;
  color: #999999;
}

.order-actions {
  display: flex;
  justify-content: flex-end;
  padding: 20rpx 30rpx;
  background: #f8f9fa;
  border-top: 1rpx solid #e9ecef;
}

.edit-amount-btn {
  background: #007aff;
  color: #ffffff;
  font-size: 24rpx;
  padding: 10rpx 20rpx;
  border-radius: 20rpx;
  border: none;
  min-width: 120rpx;
  height: 60rpx;
  line-height: 40rpx;
}

.refund-btn {
  background: #ff3b30;
  color: #ffffff;
  font-size: 24rpx;
  padding: 10rpx 20rpx;
  border-radius: 20rpx;
  border: none;
  min-width: 120rpx;
  height: 60rpx;
  line-height: 40rpx;
}

.empty-state {
  text-align: center;
  padding: 100rpx 40rpx;
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 30rpx;
  opacity: 0.5;
}

.empty-text {
  display: block;
  font-size: 28rpx;
  color: #999999;
}

.loading-state {
  text-align: center;
  padding: 60rpx;
  color: #999999;
  font-size: 28rpx;
}

.load-more {
  text-align: center;
  padding: 40rpx;
  color: #999999;
  font-size: 26rpx;
}

.no-more {
  text-align: center;
  padding: 40rpx;
  color: #999999;
  font-size: 26rpx;
} 