<view class="admin-orders-container">
  <!-- 页面标题 -->
  <view class="page-header">
    <text class="page-title">订单管理</text>
    <text class="page-subtitle">查看和管理所有订单</text>
  </view>

  <!-- 订单列表 -->
  <view class="orders-list" wx:if="{{orders && orders.length > 0}}">
    <view class="order-item" wx:for="{{orders}}" wx:key="id">
      <view class="order-content-wrapper" bindtap="onOrderDetail" data-order-id="{{item.id}}">
        <view class="order-header">
          <text class="order-no">订单号：{{item.orderNo}}</text>
          <text class="order-status" style="color: {{item.statusColor}}">
            {{item.statusText}}
          </text>
        </view>
        
        <view class="order-content">
          <view class="order-info">
            <text class="service-name">{{item.serviceName}}</text>
            <text class="user-name">用户：{{item.userNickName}}</text>
          </view>
          
          <view class="order-amount">
            <text class="amount">¥{{item.amount}}</text>
          </view>
        </view>
        
        <view class="order-footer">
          <text class="order-time">{{item.createdAt}}</text>
        </view>
      </view>
      
      <!-- 只有超级管理员且订单未支付时显示修改金额按钮 -->
      <view class="order-actions" wx:if="{{adminInfo.adminLevel === 2 && item.status === 0}}">
        <button class="edit-amount-btn" bindtap="onEditAmount" data-order="{{item}}">修改金额</button>
      </view>
      
      <!-- 只有超级管理员且订单已支付时显示退款按钮 -->
      <view class="order-actions" wx:if="{{adminInfo.adminLevel === 2 && item.status === 1}}">
        <button class="refund-btn" bindtap="onRefundOrder" data-order="{{item}}">处理退款</button>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{!loading && orders.length === 0}}">
    <image class="empty-icon" src="/images/empty-state.png" mode="aspectFit"></image>
    <text class="empty-text">暂无订单数据</text>
  </view>

  <!-- 加载状态 -->
  <view class="loading-state" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>

  <!-- 加载更多 -->
  <view class="load-more" wx:if="{{!loading && hasMore && orders.length > 0}}">
    <text>上拉加载更多</text>
  </view>

  <!-- 没有更多 -->
  <view class="no-more" wx:if="{{!loading && !hasMore && orders.length > 0}}">
    <text>没有更多数据了</text>
  </view>
</view> 