<!--pages/hospital/detail.wxml-->
<view class="hospital-detail-container">
  <!-- 加载状态 -->
  <view wx:if="{{loading}}" class="loading-container">
    <view class="loading">加载中...</view>
  </view>

  <!-- 医院详情内容 -->
  <view wx:elif="{{hospital}}" class="hospital-content">
    <!-- 医院头部信息 -->
    <view class="hospital-header">
      <image src="{{hospital.logo || '/images/hospital-default.jpg'}}" class="hospital-logo" mode="aspectFit" binderror="onImageError" />
      <view class="hospital-info">
        <text class="hospital-name">{{hospital.name}}</text>
        <text class="hospital-level">{{hospital.level}}</text>
        <text class="hospital-type">{{hospital.type}}</text>
      </view>
    </view>

    <!-- 医院基本信息 -->
    <view class="info-section">
      <view class="section-title">基本信息</view>
      <view class="info-item">
        <text class="label">地址：</text>
        <text class="value">{{hospital.address}}</text>
      </view>
      <view class="info-item">
        <text class="label">电话：</text>
        <text class="value phone" bindtap="onCallPhone">{{hospital.phone || '暂无'}}</text>
      </view>
      <view class="info-item">
        <text class="label">简介：</text>
        <text class="value">{{hospital.description || '暂无简介'}}</text>
      </view>
    </view>

    <!-- 导航信息 -->
    <view wx:if="{{navigation}}" class="navigation-section">
      <view class="section-title">导航信息</view>
      <view class="navigation-info">
        <view class="nav-item">
          <text class="label">距离：</text>
          <text class="value">{{navigation.distance}}公里</text>
        </view>
        <view class="nav-item">
          <text class="label">预计时间：</text>
          <text class="value">{{navigation.duration}}分钟</text>
        </view>
        <view class="nav-item">
          <text class="label">路线类型：</text>
          <text class="value">{{navigation.routeType === 'driving' ? '驾车' : '步行'}}</text>
        </view>
      </view>
    </view>

    <!-- 操作按钮 -->
    <view class="action-section">
      <button class="action-btn primary" bindtap="onNavigateToHospital">
        <text class="btn-icon">📍</text>
        <text class="btn-text">导航到医院</text>
      </button>
      <button class="action-btn secondary" bindtap="onCallPhone" wx:if="{{hospital.phone}}">
        <text class="btn-icon">📞</text>
        <text class="btn-text">拨打电话</text>
      </button>
      <button class="action-btn secondary" bindtap="onViewServices">
        <text class="btn-icon">🏥</text>
        <text class="btn-text">查看服务</text>
      </button>
      <button class="action-btn secondary" bindtap="onShareHospital">
        <text class="btn-icon">📤</text>
        <text class="btn-text">分享医院</text>
      </button>
    </view>

    <!-- 医院特色 -->
    <view class="features-section" wx:if="{{hospital.features}}">
      <view class="section-title">医院特色</view>
      <view class="features-list">
        <view wx:for="{{hospital.features}}" wx:key="index" class="feature-item">
          <text class="feature-icon">✓</text>
          <text class="feature-text">{{item}}</text>
        </view>
      </view>
    </view>

    <!-- 营业时间 -->
    <view class="hours-section" wx:if="{{hospital.businessHours}}">
      <view class="section-title">营业时间</view>
      <view class="hours-info">
        <text class="hours-text">{{hospital.businessHours}}</text>
      </view>
    </view>
  </view>

  <!-- 错误状态 -->
  <view wx:else class="error-container">
    <image src="/images/empty-state.png" class="error-image" mode="aspectFit" />
    <text class="error-title">医院信息不存在</text>
    <text class="error-desc">请检查医院ID是否正确</text>
    <button class="retry-btn" bindtap="loadHospitalDetail">重新加载</button>
  </view>
</view>