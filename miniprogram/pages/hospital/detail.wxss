/* pages/hospital/detail.wxss */
.hospital-detail-container {
  min-height: 100vh;
  background-color: #f5f5f5;
}

/* 加载状态 */
.loading-container {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100vh;
}

.loading {
  font-size: 28rpx;
  color: #666;
}

/* 医院详情内容 */
.hospital-content {
  padding: 20rpx;
}

/* 医院头部信息 */
.hospital-header {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.1);
}

.hospital-logo {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  margin-right: 30rpx;
}

.hospital-info {
  flex: 1;
}

.hospital-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 10rpx;
}

.hospital-level {
  font-size: 24rpx;
  color: #007aff;
  background-color: #e6f3ff;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  margin-right: 10rpx;
}

.hospital-type {
  font-size: 24rpx;
  color: #666;
  background-color: #f0f0f0;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
}

/* 信息区域 */
.info-section, .navigation-section, .features-section, .hours-section {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.1);
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  border-bottom: 1rpx solid #eee;
  padding-bottom: 10rpx;
}

.info-item, .nav-item {
  display: flex;
  margin-bottom: 15rpx;
}

.info-item:last-child, .nav-item:last-child {
  margin-bottom: 0;
}

.label {
  font-size: 28rpx;
  color: #666;
  width: 120rpx;
  flex-shrink: 0;
}

.value {
  font-size: 28rpx;
  color: #333;
  flex: 1;
  line-height: 1.5;
}

.phone {
  color: #007aff;
  text-decoration: underline;
}

/* 导航信息 */
.navigation-info {
  background-color: #f8f9fa;
  border-radius: 12rpx;
  padding: 20rpx;
}

/* 操作按钮 */
.action-section {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.action-btn {
  height: 80rpx;
  border-radius: 12rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: bold;
}

.action-btn.primary {
  background-color: #007aff;
  color: #fff;
  grid-column: 1 / -1;
}

.action-btn.secondary {
  background-color: #f0f0f0;
  color: #333;
}

.action-btn:active {
  opacity: 0.8;
}

.btn-icon {
  margin-right: 8rpx;
  font-size: 24rpx;
}

.btn-text {
  font-size: 28rpx;
}

/* 医院特色 */
.features-list {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
}

.feature-item {
  display: flex;
  align-items: center;
}

.feature-icon {
  color: #52c41a;
  font-size: 24rpx;
  margin-right: 10rpx;
}

.feature-text {
  font-size: 28rpx;
  color: #333;
}

/* 营业时间 */
.hours-info {
  background-color: #f8f9fa;
  border-radius: 12rpx;
  padding: 20rpx;
}

.hours-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.5;
}

/* 错误状态 */
.error-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100vh;
  padding: 40rpx;
}

.error-image {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 30rpx;
}

.error-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.error-desc {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 30rpx;
  text-align: center;
}

.retry-btn {
  background-color: #007aff;
  color: #fff;
  border: none;
  border-radius: 12rpx;
  padding: 20rpx 40rpx;
  font-size: 28rpx;
}