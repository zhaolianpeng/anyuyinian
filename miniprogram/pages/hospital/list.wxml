<!--pages/hospital/list.wxml-->
<view class="hospital-list-container">
  <!-- 页面标题 -->
  <view class="page-header">
    <text class="page-title">附近医院</text>
    <text class="page-subtitle">为您推荐附近的优质医院</text>
  </view>

  <!-- 加载状态 -->
  <view wx:if="{{loading}}" class="loading-container">
    <view class="loading">加载中...</view>
  </view>

  <!-- 医院列表 -->
  <view wx:elif="{{hospitals.length > 0}}" class="hospital-list">
    <view wx:for="{{hospitals}}" wx:key="id" class="hospital-item" bindtap="onHospitalDetail" data-id="{{item.id}}">
      <!-- 医院基本信息 -->
      <view class="hospital-info">
        <image src="{{item.logo || '/images/hospital-default.jpg'}}" class="hospital-logo" mode="aspectFill" binderror="onImageError" data-index="{{index}}" />
        <view class="hospital-details">
          <text class="hospital-name">{{item.name}}</text>
          <text class="hospital-level">{{item.level}}</text>
          <text class="hospital-type">{{item.type}}</text>
          <text class="hospital-address">{{item.address}}</text>
        </view>
      </view>

      <!-- 医院描述 -->
      <view class="hospital-description" wx:if="{{item.description}}">
        <text class="description-text">{{item.description}}</text>
      </view>

      <!-- 操作按钮 -->
      <view class="hospital-actions">
        <button class="action-btn primary" catchtap="onNavigateToHospital" data-hospital="{{item}}">
          <text class="btn-icon">📍</text>
          <text class="btn-text">导航</text>
        </button>
        <button class="action-btn secondary" catchtap="onCallPhone" data-phone="{{item.phone}}" wx:if="{{item.phone}}">
          <text class="btn-icon">📞</text>
          <text class="btn-text">电话</text>
        </button>
        <button class="action-btn secondary" bindtap="onHospitalDetail" data-id="{{item.id}}">
          <text class="btn-icon">🏥</text>
          <text class="btn-text">详情</text>
        </button>
      </view>
    </view>

    <!-- 加载更多提示 -->
    <view wx:if="{{!hasMore && hospitals.length > 0}}" class="no-more">
      <text class="no-more-text">已加载全部医院</text>
    </view>
  </view>

  <!-- 空状态 -->
  <view wx:else class="empty-container">
    <image src="/images/empty-state.png" class="empty-image" mode="aspectFit" />
    <text class="empty-title">暂无医院信息</text>
    <text class="empty-desc">请稍后再试或联系客服</text>
    <button class="retry-btn" bindtap="loadHospitals">重新加载</button>
  </view>
</view>