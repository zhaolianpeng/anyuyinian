.agreement-container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #f8f9fa;
}

/* 顶部导航栏 */
.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 30rpx;
  background-color: #fff;
  border-bottom: 1rpx solid #e5e5e5;
  position: sticky;
  top: 0;
  z-index: 100;
}

.back-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background-color: #f0f0f0;
}

.back-icon {
  font-size: 32rpx;
  color: #333;
  font-weight: bold;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.placeholder {
  width: 60rpx;
}

/* 内容区域 */
.content-scroll {
  flex: 1;
  background-color: #fff;
  height: calc(100vh - 240rpx); /* 减去头部和底部的高度 */
  padding-bottom: 40rpx; /* 底部留白 */
}

.content {
  padding: 40rpx 30rpx 60rpx 30rpx; /* 增加底部内边距 */
  line-height: 1.8;
}

.agreement-text {
  font-size: 28rpx;
  color: #333;
  white-space: pre-wrap;
  word-wrap: break-word;
}

/* 底部操作栏 */
.footer {
  padding: 30rpx;
  background-color: #fff;
  border-top: 1rpx solid #e5e5e5;
}

.agree-btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  font-size: 32rpx;
  font-weight: bold;
  border-radius: 44rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.agree-btn:active {
  opacity: 0.8;
} 