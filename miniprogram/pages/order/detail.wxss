/* pages/order/detail.wxss */
.order-detail-container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 120rpx;
}

/* 状态区域 */
.status-section {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 40rpx 30rpx;
  color: white;
}

.status-info {
  text-align: center;
}

.status-text {
  font-size: 36rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 10rpx;
}

.status-desc {
  font-size: 28rpx;
  opacity: 0.9;
  margin-bottom: 10rpx;
}

.countdown {
  font-size: 24rpx;
  color: #ff4757;
  background: rgba(255, 71, 87, 0.2);
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  display: inline-block;
  margin-top: 10rpx;
}

/* 服务信息 */
.service-section {
  background: white;
  margin: 20rpx;
  border-radius: 12rpx;
  padding: 30rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.service-info {
  display: flex;
  align-items: center;
}

.service-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 8rpx;
  margin-right: 20rpx;
}

.service-details {
  flex: 1;
}

.service-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 10rpx;
}

.service-price {
  font-size: 32rpx;
  color: #ff6b35;
  font-weight: bold;
  display: block;
  margin-bottom: 8rpx;
}

.service-quantity {
  font-size: 26rpx;
  color: #666;
}

/* 订单信息 */
.order-section {
  background: white;
  margin: 20rpx;
  border-radius: 12rpx;
  padding: 30rpx;
}

.order-info {
  background: #f8f9fa;
  border-radius: 8rpx;
  padding: 20rpx;
}

.info-item {
  display: flex;
  align-items: center;
  padding: 15rpx 0;
  border-bottom: 1rpx solid #eee;
}

.info-item:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 28rpx;
  color: #666;
  width: 160rpx;
  flex-shrink: 0;
}

.info-value {
  font-size: 28rpx;
  color: #333;
  flex: 1;
}

.copy-btn {
  font-size: 24rpx;
  color: #1890ff;
  padding: 8rpx 16rpx;
  border: 1rpx solid #1890ff;
  border-radius: 20rpx;
  margin-left: 20rpx;
}

/* 预约信息 */
.appointment-section {
  background: white;
  margin: 20rpx;
  border-radius: 12rpx;
  padding: 30rpx;
}

.appointment-info {
  background: #f8f9fa;
  border-radius: 8rpx;
  padding: 20rpx;
}

/* 备注信息 */
.remark-section {
  background: white;
  margin: 20rpx;
  border-radius: 12rpx;
  padding: 30rpx;
}

.remark-content {
  background: #f8f9fa;
  border-radius: 8rpx;
  padding: 20rpx;
}

.remark-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
}

/* 费用信息 */
.cost-section {
  background: white;
  margin: 20rpx;
  border-radius: 12rpx;
  padding: 30rpx;
}

.cost-info {
  background: #f8f9fa;
  border-radius: 8rpx;
  padding: 20rpx;
}

.cost-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 15rpx 0;
}

.cost-item.total {
  border-top: 1rpx solid #ddd;
  margin-top: 10rpx;
  padding-top: 20rpx;
  font-weight: bold;
}

.cost-label {
  font-size: 28rpx;
  color: #666;
}

.cost-value {
  font-size: 28rpx;
  color: #333;
}

.cost-item.total .cost-value {
  color: #ff6b35;
  font-size: 32rpx;
}

.cost-divider {
  height: 1rpx;
  background: #ddd;
  margin: 10rpx 0;
}

/* 底部操作栏 */
.bottom-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: white;
  padding: 20rpx 30rpx;
  border-top: 1rpx solid #eee;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.action-buttons {
  display: flex;
  gap: 20rpx;
}

.btn-secondary {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  line-height: 80rpx;
  padding: 0;
  box-sizing: border-box;
  text-align: center;
  background: white;
  color: #666;
  border: 1rpx solid #ddd;
  border-radius: 40rpx;
  font-size: 28rpx;
}

.btn-secondary::after {
  border: none;
}

.btn-primary {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  line-height: 80rpx;
  padding: 0;
  box-sizing: border-box;
  text-align: center;
  background: #ff6b35;
  color: white;
  border: none;
  border-radius: 40rpx;
  font-size: 28rpx;
}

.btn-primary::after {
  border: none;
}

/* 加载状态 */
.loading-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
}

.loading-content {
  background: white;
  padding: 40rpx;
  border-radius: 12rpx;
  text-align: center;
}

.loading-text {
  font-size: 28rpx;
  color: #333;
}