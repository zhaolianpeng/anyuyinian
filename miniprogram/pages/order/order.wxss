/* pages/order/order.wxss */

/* 全局样式重置 */
page {
  background-color: #f5f5f5;
  overflow-x: hidden;
  width: 100vw;
  max-width: 100vw;
  -webkit-overflow-scrolling: touch;
}

.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
  width: 100%;
  box-sizing: border-box;
  overflow-x: hidden;
  max-width: 100vw;
  position: relative;
  left: 0;
  right: 0;
  -webkit-overflow-scrolling: touch;
}

/* 服务信息 */
.service-info {
  background-color: white;
  border-radius: 12rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  width: 100%;
  box-sizing: border-box;
  max-width: 100%;
}

.service-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 8rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.service-details {
  flex: 1;
  min-width: 0;
  max-width: calc(100% - 140rpx);
}

.service-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 10rpx;
  word-break: break-all;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 100%;
}

.service-price {
  font-size: 36rpx;
  color: #ff6b6b;
  font-weight: bold;
  display: block;
  margin-bottom: 10rpx;
}

.service-desc {
  font-size: 24rpx;
  color: #666;
  display: block;
  word-break: break-all;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  white-space: normal;
  max-width: 100%;
}

/* 通用区块样式 */
.section {
  background-color: white;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  width: 100%;
  box-sizing: border-box;
  max-width: 100%;
}

.section-header {
  display: flex;
  align-items: center;
  padding: 30rpx 20rpx 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
  width: 100%;
  box-sizing: border-box;
  max-width: 100%;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.required {
  color: #ff6b6b;
  margin-left: 10rpx;
}

/* 调试信息 */
.debug-info {
  padding: 10rpx;
  background: #f0f0f0;
  font-size: 24rpx;
  color: #666;
  word-break: break-all;
  overflow: hidden;
  max-width: 100%;
}

/* 就诊人信息 */
.patient-section {
  padding: 20rpx;
  width: 100%;
  box-sizing: border-box;
  max-width: 100%;
}

.patient-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  width: 100%;
  max-width: 100%;
}

.patient-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
  border: 2rpx solid #f0f0f0;
  border-radius: 8rpx;
  transition: all 0.3s;
  width: 100%;
  box-sizing: border-box;
  max-width: 100%;
}

.patient-item.selected {
  border-color: #007aff;
  background-color: #f0f8ff;
}

.patient-info {
  flex: 1;
  min-width: 0;
  max-width: calc(100% - 120rpx);
}

.patient-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 8rpx;
  word-break: break-all;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 100%;
}

.patient-relation {
  font-size: 24rpx;
  color: #666;
  background-color: #f0f0f0;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  margin-right: 10rpx;
  display: inline-block;
  max-width: 100%;
}

.patient-phone {
  font-size: 24rpx;
  color: #999;
  word-break: break-all;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 100%;
}

.patient-actions {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-shrink: 0;
  max-width: 120rpx;
}

.default-tag {
  background-color: #ff6b6b;
  color: white;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  white-space: nowrap;
}

.check-icon {
  color: #007aff;
  font-size: 32rpx;
  font-weight: bold;
}

/* 地址信息 */
.address-section {
  padding: 20rpx;
  width: 100%;
  box-sizing: border-box;
  max-width: 100%;
}

.address-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  width: 100%;
  max-width: 100%;
}

.address-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
  border: 2rpx solid #f0f0f0;
  border-radius: 8rpx;
  transition: all 0.3s;
  width: 100%;
  box-sizing: border-box;
  max-width: 100%;
}

.address-item.selected {
  border-color: #007aff;
  background-color: #f0f8ff;
}

.address-info {
  flex: 1;
  min-width: 0;
  max-width: calc(100% - 120rpx);
}

.address-user {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
  flex-wrap: wrap;
  max-width: 100%;
}

.address-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-right: 20rpx;
  word-break: break-all;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 60%;
}

.address-phone {
  font-size: 24rpx;
  color: #666;
  word-break: break-all;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 40%;
}

.address-detail {
  font-size: 24rpx;
  color: #666;
  line-height: 1.4;
  word-break: break-all;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  white-space: normal;
  max-width: 100%;
}

.address-actions {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-shrink: 0;
  max-width: 120rpx;
}

/* 预约时间 */
.appointment-section {
  padding: 20rpx;
  width: 100%;
  box-sizing: border-box;
  max-width: 100%;
}

.date-section, .time-section, .datetime-section {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
  width: 100%;
  box-sizing: border-box;
  max-width: 100%;
}

.date-section:last-child, .time-section:last-child, .datetime-section:last-child {
  border-bottom: none;
}

.datetime-picker {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx;
  border: 1rpx solid #e0e0e0;
  border-radius: 8rpx;
  background-color: #fff;
  min-width: 0;
  max-width: calc(100% - 200rpx);
}

.picker-arrow {
  color: #999;
  font-size: 24rpx;
  margin-left: 10rpx;
}

.label {
  width: 200rpx;
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  flex-shrink: 0;
}

.picker {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  min-width: 0;
  max-width: calc(100% - 200rpx);
}

.placeholder {
  color: #999;
}

/* 时间提示 */
.time-hint {
  padding: 20rpx 0;
  text-align: center;
  width: 100%;
  box-sizing: border-box;
  max-width: 100%;
}

.hint-text {
  font-size: 24rpx;
  color: #666;
  background-color: #f8f8f8;
  padding: 8rpx 16rpx;
  border-radius: 4rpx;
  display: inline-block;
  word-break: break-all;
  max-width: 100%;
}

/* 备注信息 */
.remark-section {
  padding: 20rpx;
  position: relative;
  width: 100%;
  box-sizing: border-box;
  max-width: 100%;
}

.remark-input {
  width: 100%;
  min-height: 120rpx;
  padding: 20rpx;
  border: 1rpx solid #e0e0e0;
  border-radius: 8rpx;
  font-size: 28rpx;
  line-height: 1.5;
  box-sizing: border-box;
  word-break: break-all;
  max-width: 100%;
}

.char-count {
  position: absolute;
  bottom: 30rpx;
  right: 30rpx;
  font-size: 24rpx;
  color: #999;
}

/* 空状态 */
.empty-state {
  padding: 60rpx 20rpx;
  text-align: center;
  width: 100%;
  box-sizing: border-box;
  max-width: 100%;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
  display: block;
  margin-bottom: 30rpx;
}

.add-btn {
  background-color: #007aff;
  color: white;
  border: none;
  padding: 16rpx 32rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
}

/* 添加更多按钮 */
.add-more-section {
  padding: 20rpx 0;
  text-align: center;
  width: 100%;
  box-sizing: border-box;
  max-width: 100%;
}

.add-more-btn {
  background-color: transparent;
  color: #007aff;
  border: 1rpx solid #007aff;
  padding: 12rpx 24rpx;
  border-radius: 6rpx;
  font-size: 24rpx;
  line-height: 1.5;
}

/* 订单金额 */
.order-amount {
  background-color: white;
  border-radius: 12rpx;
  padding: 30rpx 20rpx;
  margin-bottom: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  width: 100%;
  box-sizing: border-box;
  max-width: 100%;
}

.amount-label {
  font-size: 28rpx;
  color: #333;
}

.amount-value {
  font-size: 36rpx;
  color: #ff6b6b;
  font-weight: bold;
}

/* 调试按钮区域 */
.debug-section {
  padding: 20rpx;
  background: #f0f0f0;
  width: 100%;
  box-sizing: border-box;
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  max-width: 100%;
}

.debug-section button {
  margin: 0;
  flex: 1;
  min-width: 200rpx;
  font-size: 24rpx;
  padding: 16rpx 20rpx;
  max-width: calc(50% - 5rpx);
}

/* 提交按钮 */
.submit-section {
  padding: 40rpx 20rpx;
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: white;
  border-top: 1rpx solid #f0f0f0;
  width: 100%;
  box-sizing: border-box;
  z-index: 1000;
  max-width: 100vw;
}

.submit-btn {
  width: 100%;
  background-color: #007aff;
  color: white;
  border: none;
  padding: 24rpx;
  border-radius: 8rpx;
  font-size: 32rpx;
  box-sizing: border-box;
  max-width: 100%;
}

.submit-btn[disabled] {
  background-color: #ccc;
}

/* 防止页面底部被提交按钮遮挡 */
.container {
  padding-bottom: 120rpx;
}

/* 患者性别和年龄标签 */
.patient-gender, .patient-age {
  font-size: 22rpx;
  color: #666;
  background-color: #f0f0f0;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  margin-right: 10rpx;
  display: inline-block;
  max-width: 100%;
}

/* 患者信息显示 */
.info-section {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
  width: 100%;
  box-sizing: border-box;
  max-width: 100%;
}

.info-section:last-child {
  border-bottom: none;
}

.info-value {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  text-align: right;
  margin-left: 20rpx;
}

/* 基础病信息 */
.disease-section {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
  width: 100%;
  box-sizing: border-box;
  max-width: 100%;
  position: relative;
}

.disease-input {
  width: 100%;
  min-height: 120rpx;
  padding: 20rpx;
  border: 1rpx solid #e0e0e0;
  border-radius: 8rpx;
  font-size: 28rpx;
  line-height: 1.5;
  box-sizing: border-box;
  word-break: break-all;
  max-width: 100%;
  margin-top: 10rpx;
}

/* 助排二便选择 */
.toilet-section {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
  width: 100%;
  box-sizing: border-box;
  max-width: 100%;
}

.radio-group {
  display: flex;
  gap: 40rpx;
  margin-top: 10rpx;
}

.radio-item {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 8rpx;
  transition: all 0.3s;
  cursor: pointer;
}

.radio-item.selected {
  border-color: #007aff;
  background-color: #f0f8ff;
}

.radio-icon {
  font-size: 32rpx;
  color: #007aff;
  margin-right: 12rpx;
  width: 32rpx;
  text-align: center;
}

.radio-text {
  font-size: 28rpx;
  color: #333;
}

/* 响应式设计 - 小屏幕适配 */
@media screen and (max-width: 375px) {
  .container {
    padding: 15rpx;
  }
  
  .service-info {
    padding: 20rpx;
  }
  
  .section-header {
    padding: 20rpx 15rpx 15rpx;
  }
  
  .patient-section,
  .address-section,
  .appointment-section,
  .remark-section {
    padding: 15rpx;
  }
  
  .label {
    width: 160rpx;
    font-size: 26rpx;
  }
  
  .picker {
    max-width: calc(100% - 160rpx);
  }
  
  .debug-section button {
    min-width: 150rpx;
    font-size: 22rpx;
    padding: 12rpx 16rpx;
  }
  
  .radio-group {
    gap: 20rpx;
  }
  
  .radio-item {
    padding: 12rpx 16rpx;
  }
  
  .radio-text {
    font-size: 24rpx;
  }
}

/* 响应式设计 - 大屏幕适配 */
@media screen and (min-width: 414px) {
  .container {
    padding: 30rpx;
    max-width: 750rpx;
    margin: 0 auto;
  }
  
  .service-info {
    padding: 40rpx;
  }
  
  .section-header {
    padding: 40rpx 30rpx 30rpx;
  }
  
  .patient-section,
  .address-section,
  .appointment-section,
  .remark-section {
    padding: 30rpx;
  }
  
  .radio-group {
    gap: 60rpx;
  }
  
  .radio-item {
    padding: 20rpx 32rpx;
  }
}

/* 禁止左右滑动的额外样式 */
view, text, image, button, input, textarea, scroll-view {
  max-width: 100vw;
  overflow-x: hidden;
}

/* 确保所有文本不会导致水平滚动 */
text, textarea, input {
  word-wrap: break-word;
  word-break: break-all;
  white-space: normal;
  max-width: 100%;
  overflow-x: hidden;
}

/* 防止flex布局导致的溢出 */
.flex {
  max-width: 100vw;
  overflow-x: hidden;
}

/* 确保按钮不会超出容器 */
button {
  max-width: 100%;
  overflow-x: hidden;
}