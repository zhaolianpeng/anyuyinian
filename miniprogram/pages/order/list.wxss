.order-list-container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-top: 0; /* 确保没有额外的顶部间距 */
}

/* 实时通信状态 */
.realtime-status {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
  background: white;
  border-bottom: 1rpx solid #f0f0f0;
  position: relative;
  z-index: 10;
}

.status-indicator {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.status-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  animation: pulse 2s infinite;
}

.status-dot.connected {
  background: #52c41a;
}

.status-dot.disconnected {
  background: #faad14;
}

.status-text {
  font-size: 24rpx;
  color: #666;
}

.refresh-btn {
  padding: 8rpx 20rpx;
  background: #007aff;
  color: white;
  border: none;
  border-radius: 20rpx;
  font-size: 24rpx;
}

.refresh-btn:active {
  background: #0056cc;
}

@keyframes pulse {
  0% {
    opacity: 1;
  }
  50% {
    opacity: 0.5;
  }
  100% {
    opacity: 1;
  }
}

.status-tabs {
  background: white;
  border-bottom: 1rpx solid #f0f0f0;
  position: sticky;
  top: 0;
  z-index: 1000; /* 提高z-index确保在最上层 */
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1); /* 添加阴影效果 */
  width: 100%;
  overflow: hidden; /* 防止内容溢出 */
}

.status-scroll {
  white-space: nowrap;
  width: 100%;
  overflow-x: auto; /* 确保可以横向滚动 */
}

.status-list {
  display: flex;
  padding: 20rpx;
  gap: 20rpx;
  min-width: 100%;
  flex-wrap: nowrap; /* 防止换行 */
}

.status-item {
  padding: 15rpx 30rpx;
  border-radius: 25rpx;
  font-size: 28rpx;
  color: #666;
  background: #f8f8f8;
  white-space: nowrap;
  display: flex;
  align-items: center;
  gap: 8rpx;
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
  cursor: pointer;
  user-select: none;
  flex-shrink: 0; /* 防止tab被压缩 */
  min-width: fit-content; /* 确保内容不被截断 */
}

.status-item::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.4), transparent);
  transition: left 0.5s;
}

.status-item:active::before {
  left: 100%;
}

.status-item.active {
  background: linear-gradient(135deg, #007aff, #0056cc);
  color: white;
  box-shadow: 0 4rpx 12rpx rgba(0, 122, 255, 0.3);
  transform: translateY(-2rpx);
  font-weight: 600;
}

.status-name {
  font-weight: 500;
}

.status-count {
  font-size: 24rpx;
  opacity: 0.8;
  background: rgba(255, 255, 255, 0.2);
  padding: 2rpx 8rpx;
  border-radius: 10rpx;
  min-width: 32rpx;
  text-align: center;
}

.status-item.active .status-count {
  background: rgba(255, 255, 255, 0.3);
}

/* Tab切换加载状态 */
.tab-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 20rpx;
  background: white;
  min-height: 400rpx;
  position: relative;
  z-index: 1;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 6rpx solid #f0f0f0;
  border-top: 6rpx solid #007aff;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 30rpx;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.tab-loading text {
  font-size: 28rpx;
  color: #666;
}

.order-list {
  padding: 20rpx;
  position: relative;
  z-index: 1;
}

.order-item {
  background: white;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
  transition: all 0.3s ease;
}

.order-item:active {
  transform: scale(0.98);
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.15);
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.status-info {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
}

.countdown {
  font-size: 22rpx;
  color: #ff4757;
  background: rgba(255, 71, 87, 0.1);
  padding: 4rpx 8rpx;
  border-radius: 8rpx;
  animation: pulse 2s infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.7; }
}

.pay-deadline {
  font-size: 22rpx;
  color: #ff9500;
  background: rgba(255, 149, 0, 0.1);
  padding: 4rpx 8rpx;
  border-radius: 8rpx;
}

.order-no {
  font-size: 26rpx;
  color: #666;
}

.order-status {
  font-size: 26rpx;
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  font-weight: 500;
}

.status-pending {
  color: #ff9500;
  background: rgba(255, 149, 0, 0.1);
}

.status-paid {
  color: #34c759;
  background: rgba(52, 199, 89, 0.1);
}

.status-cancelled {
  color: #999;
  background: rgba(153, 153, 153, 0.1);
}

.status-refunded {
  color: #ff4757;
  background: rgba(255, 71, 87, 0.1);
}

.order-content {
  padding: 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.service-info {
  flex: 1;
  margin-right: 20rpx;
}

.service-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 15rpx;
  line-height: 1.4;
}

.service-details {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.appointment-info,
.consult-time {
  font-size: 26rpx;
  color: #666;
  line-height: 1.4;
}

.order-amount {
  text-align: right;
}

.amount {
  font-size: 36rpx;
  font-weight: 600;
  color: #ff4757;
}

.order-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 30rpx;
  background: #fafafa;
  border-top: 1rpx solid #f0f0f0;
}

.order-time {
  font-size: 24rpx;
  color: #999;
}

.order-actions {
  display: flex;
  gap: 15rpx;
}

.action-btn {
  padding: 12rpx 24rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  border: none;
  min-width: 120rpx;
  text-align: center;
  transition: all 0.3s ease;
}

.cancel-btn {
  background: #f8f8f8;
  color: #666;
}

.cancel-btn:active {
  background: #e8e8e8;
}

.pay-btn {
  background: linear-gradient(135deg, #ff4757, #ff3742);
  color: white;
}

.pay-btn:active {
  transform: scale(0.95);
}

.refund-btn {
  background: linear-gradient(135deg, #ff9500, #ff8c00);
  color: white;
}

.refund-btn:active {
  transform: scale(0.95);
}

.loading-more {
  text-align: center;
  padding: 40rpx;
  color: #999;
  font-size: 28rpx;
}

.no-more {
  text-align: center;
  padding: 40rpx;
  color: #999;
  font-size: 28rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
  text-align: center;
}

.empty-state image {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 40rpx;
  opacity: 0.6;
}

.empty-text {
  font-size: 32rpx;
  color: #666;
  margin-bottom: 20rpx;
  font-weight: 500;
}

.empty-desc {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 40rpx;
}

.go-service-btn {
  background: linear-gradient(135deg, #007aff, #0056cc);
  color: white;
  padding: 20rpx 40rpx;
  border-radius: 25rpx;
  font-size: 28rpx;
  border: none;
  box-shadow: 0 4rpx 12rpx rgba(0, 122, 255, 0.3);
  transition: all 0.3s ease;
}

.go-service-btn:active {
  transform: scale(0.95);
  box-shadow: 0 2rpx 8rpx rgba(0, 122, 255, 0.4);
} 