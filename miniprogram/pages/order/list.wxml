<view class="order-list-container">

  <!-- 登录门：未登录仅显示去登录按钮（按钮风格与登录页一致） -->
  <view class="login-gate" wx:if="{{needLogin}}">
    <button class="primary-login-btn" bindtap="onGoLogin">去登录</button>
  </view>
  <!-- 实时通信状态 -->
  <view class="realtime-status" wx:if="{{realtimeUpdates}}">
    <view class="status-indicator">
      <view class="status-dot {{websocketConnected ? 'connected' : 'disconnected'}}"></view>
      <text class="status-text">{{websocketConnected ? '实时连接' : '轮询更新'}}</text>
    </view>
    <button class="refresh-btn" bindtap="checkRealtimeUpdates">刷新</button>
  </view>

  <!-- 状态筛选 -->
  <view class="status-tabs" wx:if="{{!needLogin}}">
    <scroll-view scroll-x class="status-scroll" enhanced="true" show-scrollbar="false">
      <view class="status-list">
        <view 
          class="status-item {{currentTab === index ? 'active' : ''}}"
          wx:for="{{statusOptions}}"
          wx:key="value"
          data-index="{{index}}"
          bindtap="onStatusSelect"
        >
          <text class="status-name">{{item.name}}</text>
          <text class="status-count" wx:if="{{item.count > 0}}">({{item.count}})</text>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- Tab切换加载状态 -->
  <view class="tab-loading" wx:if="{{tabLoading && !needLogin}}">
    <view class="loading-spinner"></view>
    <text>切换中...</text>
  </view>

  <!-- 订单列表 -->
  <view class="order-list" wx:if="{{!tabLoading && !needLogin}}">
    <view 
      class="order-item"
      wx:for="{{orders}}"
      wx:key="id"
      data-order-id="{{item.id}}"
      data-order-no="{{item.orderNo}}"
      bindtap="onOrderTap"
    >
      <view class="order-header">
        <text class="order-no">订单号：{{item.orderNo}}</text>
        <view class="status-info">
          <text class="order-status {{getStatusClass(item.status)}}">{{getStatusText(item.status)}}</text>
          <text class="countdown" wx:if="{{item.status === 'pending_pay' && item.countdown}}">{{item.countdown}}</text>
          <text class="pay-deadline" wx:if="{{item.status === 'pending_pay' && item.formattedPayDeadline}}">支付截止：{{item.formattedPayDeadline}}</text>
        </view>
      </view>

      <view class="order-content">
        <view class="service-info">
          <text class="service-title">{{item.serviceName}}</text>
          <view class="service-details">
            <text class="appointment-info">预约时间：{{item.appointmentDate}} {{item.appointmentTime}}</text>
            <text class="consult-time" wx:if="{{item.consultTime}}">沟通时间：{{item.consultTime}}</text>
          </view>
        </view>
        <view class="order-amount">
          <text class="amount">{{item.formattedAmount}}</text>
        </view>
      </view>

      <view class="order-footer">
        <text class="order-time">{{item.formattedDate}}</text>
        <view class="order-actions">
          <button 
            class="action-btn cancel-btn" 
            wx:if="{{item.status === 0}}"
            data-order-id="{{item.id}}"
            data-order-no="{{item.orderNo}}"
            bindtap="onCancelOrder"
            catchtap="true"
          >
            取消订单
          </button>
          <button 
            class="action-btn pay-btn" 
            wx:if="{{item.status === 0}}"
            data-order-id="{{item.id}}"
            data-order-no="{{item.orderNo}}"
            bindtap="onPayOrder"
            catchtap="true"
          >
            立即支付
          </button>
          <button 
            class="action-btn refund-btn" 
            wx:if="{{item.status === 1 && item.refundStatus === 0}}"
            data-order-id="{{item.id}}"
            data-order-no="{{item.orderNo}}"
            bindtap="onRefundOrder"
            catchtap="true"
          >
            申请退款
          </button>
        </view>
      </view>
    </view>
  </view>

  <!-- 加载状态 -->
  <view class="loading-more" wx:if="{{loading && !tabLoading && !needLogin}}">
    <text>加载中...</text>
  </view>

  <view class="no-more" wx:if="{{!hasMore && orders.length > 0 && !tabLoading && !needLogin}}">
    <text>没有更多了</text>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{!loading && orders.length === 0 && !tabLoading && !needLogin}}">
    <image src="/images/empty-state.png" mode="aspectFit"></image>
    <text class="empty-text">暂无{{statusOptions[currentTab].name}}订单</text>
    <text class="empty-desc">您还没有{{statusOptions[currentTab].name}}的订单</text>
    <button class="go-service-btn" bindtap="goToService">去预约服务</button>
  </view>
</view> 