.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

.header {
  text-align: center;
  margin-bottom: 40rpx;
}

.title {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.subtitle {
  display: block;
  font-size: 28rpx;
  color: #666;
}

.status-section {
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.status-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.status-label {
  font-size: 28rpx;
  color: #666;
}

.status-value {
  font-size: 28rpx;
  font-weight: 500;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
}

.status-value.connected {
  background: rgba(52, 199, 89, 0.1);
  color: #34c759;
}

.status-value.disconnected {
  background: rgba(255, 71, 87, 0.1);
  color: #ff4757;
}

.test-buttons {
  margin-bottom: 30rpx;
}

.test-btn {
  margin: 10rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  border: none;
  transition: all 0.3s ease;
}

.test-btn.primary {
  background: linear-gradient(135deg, #007aff, #0056cc);
  color: white;
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
}

.test-btn.secondary {
  background: white;
  color: #007aff;
  border: 2rpx solid #007aff;
  flex: 1;
  height: 70rpx;
  line-height: 70rpx;
}

.test-btn:active {
  transform: scale(0.95);
}

.button-row {
  display: flex;
  gap: 20rpx;
}

.action-buttons {
  display: flex;
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.action-btn {
  flex: 1;
  background: #f8f8f8;
  color: #666;
  border: none;
  border-radius: 12rpx;
  font-size: 28rpx;
  height: 70rpx;
  line-height: 70rpx;
}

.action-btn:active {
  background: #e8e8e8;
}

.results-section {
  background: white;
  border-radius: 16rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
  overflow: hidden;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
  background: #fafafa;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.result-count, .message-count {
  font-size: 24rpx;
  color: #999;
}

.results-list {
  max-height: 600rpx;
}

.result-item {
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.result-item:last-child {
  border-bottom: none;
}

.result-item.success {
  border-left: 6rpx solid #34c759;
}

.result-item.error {
  border-left: 6rpx solid #ff4757;
}

.result-item.info {
  border-left: 6rpx solid #007aff;
}

.result-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 15rpx;
}

.result-time {
  font-size: 24rpx;
  color: #999;
}

.result-status {
  font-size: 24rpx;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  font-weight: 500;
}

.result-item.success .result-status {
  background: rgba(52, 199, 89, 0.1);
  color: #34c759;
}

.result-item.error .result-status {
  background: rgba(255, 71, 87, 0.1);
  color: #ff4757;
}

.result-item.info .result-status {
  background: rgba(0, 122, 255, 0.1);
  color: #007aff;
}

.result-message {
  font-size: 28rpx;
  color: #333;
  line-height: 1.5;
  word-break: break-all;
}

.result-data {
  margin-top: 15rpx;
  padding: 15rpx;
  background: #f8f8f8;
  border-radius: 8rpx;
}

.data-label {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 8rpx;
  display: block;
}

.data-content {
  font-size: 24rpx;
  color: #333;
  word-break: break-all;
  line-height: 1.4;
}

.websocket-section {
  background: white;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
  overflow: hidden;
}

.message-list {
  max-height: 400rpx;
}

.message-item {
  padding: 20rpx 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.message-item:last-child {
  border-bottom: none;
}

.message-header {
  margin-bottom: 10rpx;
}

.message-time {
  font-size: 24rpx;
  color: #999;
}

.message-content {
  font-size: 26rpx;
  color: #333;
  line-height: 1.4;
  word-break: break-all;
} 