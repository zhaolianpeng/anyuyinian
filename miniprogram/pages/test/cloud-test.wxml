<view class="container">
  <view class="header">
    <text class="title">服务端连通性测试</text>
    <text class="subtitle">测试统一服务端 API 调用与错误处理</text>
  </view>

  <!-- 测试按钮 -->
  <view class="test-buttons">
    <button class="test-btn primary" bindtap="runAllTests" loading="{{loading}}">
      运行所有测试
    </button>
    
    <view class="button-row">
      <button class="test-btn secondary" bindtap="testBasicConnection">
        基本连接测试
      </button>
      <button class="test-btn secondary" bindtap="testHomeAPI">
        首页API测试
      </button>
    </view>
    
    <view class="button-row">
      <button class="test-btn secondary" bindtap="testOrderListAPI">
        订单API测试
      </button>
      <button class="test-btn secondary" bindtap="testServiceListAPI">
        服务API测试
      </button>
    </view>
    
    <view class="button-row">
      <button class="test-btn secondary" bindtap="testCloudContainerStatus">
        请求环境
      </button>
      <button class="test-btn secondary" bindtap="testErrorHandling">
        错误处理测试
      </button>
    </view>
  </view>

  <!-- 操作按钮 -->
  <view class="action-buttons">
    <button class="action-btn" bindtap="clearTestResults">
      清空结果
    </button>
    <button class="action-btn" bindtap="copyTestResults">
      复制结果
    </button>
  </view>

  <!-- 测试结果 -->
  <view class="results-section">
    <view class="section-header">
      <text class="section-title">测试结果</text>
      <text class="result-count">({{testResults.length}})</text>
    </view>
    
    <scroll-view class="results-list" scroll-y="true">
      <view 
        class="result-item {{item.message.includes('✅') ? 'success' : item.message.includes('❌') ? 'error' : 'info'}}"
        wx:for="{{testResults}}"
        wx:key="timestamp"
      >
        <view class="result-header">
          <text class="result-time">{{item.timestamp}}</text>
          <text class="result-status">{{item.message.includes('✅') ? '成功' : item.message.includes('❌') ? '失败' : '信息'}}</text>
        </view>
        <text class="result-message">{{item.message}}</text>
        <view class="result-data" wx:if="{{item.data}}">
          <text class="data-label">数据:</text>
          <text class="data-content">{{item.data}}</text>
        </view>
      </view>
    </scroll-view>
  </view>

</view> 