/* pages/kefu/chat.wxss */
.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #f5f5f5;
}

.chat-list {
  flex: 1;
  padding: 20rpx;
}

.message-list {
  padding-bottom: 20rpx;
}

.message-item {
  display: flex;
  margin-bottom: 30rpx;
  align-items: flex-start;
}

.message-item.user {
  flex-direction: row-reverse;
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  overflow: hidden;
  margin: 0 20rpx;
}

.avatar image {
  width: 100%;
  height: 100%;
}

.message-content {
  flex: 1;
  max-width: 70%;
}

.message-bubble {
  background-color: white;
  padding: 20rpx;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
  word-wrap: break-word;
}

.message-item.user .message-bubble {
  background-color: #007aff;
  color: white;
}

.message-time {
  font-size: 24rpx;
  color: #999;
  margin-top: 10rpx;
  text-align: center;
}

.image-list {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 10rpx;
}

.image-list image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 8rpx;
}

.input-area {
  background-color: white;
  border-top: 1rpx solid #f0f0f0;
  padding: 20rpx;
  box-sizing: border-box;
}

.input-container {
  display: flex;
  align-items: center;
  gap: 20rpx;
  width: 100%;
}

.message-input-wrap {
  flex: 1;
  min-width: 0;
  height: 80rpx;
  padding: 0 20rpx;
  border: 1rpx solid #e0e0e0;
  border-radius: 8rpx;
  box-sizing: border-box;
  background-color: #fff;
  display: flex;
  align-items: center;
}

.message-input {
  display: block;
  width: 100%;
  height: 100%;
  border: none;
  padding: 0;
  font-size: 28rpx;
  box-sizing: border-box;
  background-color: #fff;
}

.input-actions {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.send-btn {
  min-width: 112rpx;
  height: 80rpx;
  padding: 0 32rpx;
  border: none;
  border-radius: 8rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.send-btn::after {
  border: none;
}

.send-btn-active {
  background-color: #007aff;
  color: white;
}

.send-btn-disabled {
  background-color: #ccc;
  color: white;
}

.quick-reply {
  background-color: white;
  border-top: 1rpx solid #f0f0f0;
  padding: 20rpx;
}

.quick-reply-list {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.quick-reply-item {
  background-color: #f0f0f0;
  color: #333;
  border: none;
  padding: 16rpx 24rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
}