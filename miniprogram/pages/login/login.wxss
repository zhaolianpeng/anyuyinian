.login-container {
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding: 40rpx;
}

.login-card {
  background: white;
  border-radius: 20rpx;
  padding: 60rpx 40rpx;
  width: 100%;
  max-width: 600rpx;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.1);
}

.login-title {
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
  text-align: center;
  margin-bottom: 40rpx;
}

.login-subtitle {
  font-size: 28rpx;
  color: #666;
  text-align: center;
  margin-bottom: 60rpx;
  line-height: 1.5;
}

.login-btn {
  background: #007aff;
  color: white;
  border: none;
  border-radius: 50rpx;
  padding: 30rpx;
  font-size: 32rpx;
  width: 100%;
  margin-bottom: 30rpx;
}

.login-btn:active {
  background: #0056cc;
}

.login-btn[disabled] {
  background: #ccc;
  color: #999;
}

.login-tips {
  text-align: center;
  font-size: 24rpx;
  color: #999;
  line-height: 1.5;
}

.login-tips .link {
  color: #007aff;
}

.loading {
  text-align: center;
  color: #666;
  font-size: 28rpx;
  margin-top: 40rpx;
} 