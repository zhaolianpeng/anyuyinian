.test-container {
  padding: 30rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

.test-header {
  text-align: center;
  margin-bottom: 40rpx;
}

.test-title {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.test-subtitle {
  display: block;
  font-size: 26rpx;
  color: #666;
}

.test-results {
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 40rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.test-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.test-item:last-child {
  border-bottom: none;
}

.test-name {
  flex: 1;
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
}

.test-description {
  flex: 2;
  font-size: 24rpx;
  color: #666;
  margin: 0 20rpx;
}

.test-status {
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.test-status.passed {
  background: #f6ffed;
  color: #52c41a;
  border: 1rpx solid #b7eb8f;
}

.test-status.failed {
  background: #fff2f0;
  color: #ff4d4f;
  border: 1rpx solid #ffccc7;
}

.test-actions {
  display: flex;
  gap: 20rpx;
}

.retry-btn, .home-btn {
  flex: 1;
  height: 80rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.retry-btn {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
}

.home-btn {
  background: white;
  color: #667eea;
  border: 2rpx solid #667eea;
}
